# MySQL connection used by Prisma. URL-encode reserved password characters.
DATABASE_URL="mysql://nyxxyr_app:password@127.0.0.1:3306/nyxxyr_project_showcase"

# Optional read-only token for a higher GitHub API rate limit.
# Never expose this value to the browser or commit a real token.
GITHUB_TOKEN=

# Server-only credentials for the admin dashboard.
# Generate ADMIN_NIK_HASH with a salted scrypt hash. Never store the raw NIK.
ADMIN_NIK_HASH=
ADMIN_SESSION_SECRET=
